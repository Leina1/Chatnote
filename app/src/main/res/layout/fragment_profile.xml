<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/profileRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F8F8"
    tools:context=".fragment.ProfileFragment">

    <!-- Toolbar -->

    <!-- ScrollView Nội Dung -->
    <RelativeLayout
        android:id="@+id/profileToolbar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#FF2626"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/profileToolbarTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="24dp"
            android:layout_marginTop="13dp"
            android:layout_marginBottom="6dp"
            android:text="Hồ sơ"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <ScrollView
        android:id="@+id/profileScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/profileToolbar"
        android:layout_above="@id/bottomNav"
        android:fillViewport="true"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/mainLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- AVATAR -->
            <FrameLayout
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_marginTop="24dp">

                <ImageView
                    android:id="@+id/profileImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_placeholder"
                    android:scaleType="centerCrop"
                    android:background="@drawable/avatar_circle_mask"
                    android:clipToOutline="true" />

                <ImageButton
                    android:id="@+id/btnChangeAvatar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_circle_white"
                    android:src="@drawable/ic_edit"
                    android:tint="#FF2626" />
            </FrameLayout>

            <!-- Thông tin người dùng -->
            <TextView
                android:id="@+id/displayName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="User123"
                android:textColor="#222222"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="email@gmail.com"
                android:textColor="#777777"
                android:textSize="16sp" />

            <!-- Card Bio -->
            <LinearLayout
                android:id="@+id/bioCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_card_white"
                android:elevation="4dp">

                <TextView
                    android:id="@+id/bio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Chưa có giới thiệu."
                    android:textColor="#555555"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Các nút hành động -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="28dp"
                android:gravity="center_horizontal">

                <Button
                    android:id="@+id/editProfileBtn"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="Chỉnh sửa hồ sơ"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#FF2626"
                    android:textStyle="bold"
                    android:elevation="3dp"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btnLogout"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="Đăng xuất"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#E20315"
                    android:elevation="3dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</RelativeLayout>
