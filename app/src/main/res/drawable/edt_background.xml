<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Màu nền EditText -->
    <solid android:color="#F5F5F5" />

    <!-- Viền EditText -->
    <stroke
        android:width="1dp"
        android:color="#CCCCCC" />

    <!-- Bo góc -->
    <corners android:radius="8dp" />

    <!-- Padding nội bộ -->
    <padding
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp" />
</shape>
